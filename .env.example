# Copy this file to .env on the Linux/RunPod machine and edit paths.
# Keep all large assets under /workspace so they survive a Pod restart.

RUNPOD_ROOT=/workspace
MODEL_ROOT=/workspace/models/wan22_i2v_a14b
OUTPUT_ROOT=/workspace/outputs/babaji_wan22_i2v
MUSUBI_DIR=/workspace/tools/musubi-tuner
VENV_DIR=/workspace/venvs/wan22-babaji
HF_HOME=/workspace/.cache/huggingface

# The downloaded step-200 high-noise LoRA from this workspace.
LORA_PATH=/workspace/nagharsubject_high_checkpoints/high/nagharsubject_high-step00000200.safetensors
EXPECTED_LORA_SHA256=a05589023b0128de81a599e70632bec1a2e5cc7c172718182d25602f6e8311b4

# These images are 768x576 and are used as the first frame for I2V.
REFERENCE_ROOT=/workspace/prepared_wan22_i2v_curated/reference_images
REFERENCE_IMAGE=/workspace/prepared_wan22_i2v_curated/reference_images/open_palm.png

# quality_offload: FP16 with 8 CPU-swapped DiT blocks; recommended for 80 GB GPUs
# quality: FP16 without block swapping; fastest but can exceed 80 GB during LoRA merge/cast
# balanced: scaled FP8, 48 GB-class GPU recommended
# low_vram: FP8 plus block swapping, 24 GB minimum (slowest)
# rtx5090_quality: scaled FP8 plus 12 swapped blocks for 32 GB Blackwell
# rtx5090_fast: faster FP8 arithmetic on RTX 40/50 series; lower quality
# rtx5090_safe: scaled FP8 plus 20 swapped blocks if rtx5090_quality OOMs
MEMORY_PROFILE=quality_offload

# Helps reduce allocator fragmentation. It cannot compensate for a genuinely
# oversized model-loading peak, which is why quality_offload is the default.
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

LORA_STRENGTH=1.0
SEED=42
VERIFY_MODEL_HASHES=1
VERIFY_LORA_HASH=1

# Set HF_TOKEN in the RunPod secret/environment UI if a download requires it.
# Do not commit a token to this file.
# HF_TOKEN=hf_...

# Reproducible tool/runtime settings.
MUSUBI_COMMIT=f8a1b03794a49239a3539015075f5123d6c07d66
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128

