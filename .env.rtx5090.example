# Copy to .env on the RTX 5090 Linux system. Replace /data/wan22 if needed.
SYSTEM_ROOT=/data/wan22
MODEL_ROOT=/data/wan22/models/wan22_i2v_a14b
OUTPUT_ROOT=/data/wan22/outputs/babaji_wan22_i2v
MUSUBI_DIR=/data/wan22/tools/musubi-tuner
VENV_DIR=/data/wan22/venvs/wan22-babaji
HF_HOME=/data/wan22/.cache/huggingface

# The selected high-noise LoRA. The comparison runner overrides this per run.
LORA_PATH=/data/wan22/nagharsubject_high_checkpoints/high/nagharsubject_high-step00000200.safetensors
EXPECTED_LORA_SHA256=a05589023b0128de81a599e70632bec1a2e5cc7c172718182d25602f6e8311b4

REFERENCE_ROOT=/data/wan22/reference_images
REFERENCE_IMAGE=/data/wan22/reference_images/open_palm.png

# Use rtx5090_quality while selecting between checkpoints.
# rtx5090_fast enables faster FP8 arithmetic with a quality tradeoff.
# rtx5090_safe swaps 20 blocks instead of 12 if quality mode runs out of VRAM.
MEMORY_PROFILE=rtx5090_quality
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

LORA_STRENGTH=1.0
SEED=42
VERIFY_MODEL_HASHES=1
VERIFY_LORA_HASH=1

# Supply HF_TOKEN in the shell or secret manager if Hugging Face requests it.
# Never commit a real token to GitHub or write it in this file.
# HF_TOKEN=hf_...

MUSUBI_COMMIT=f8a1b03794a49239a3539015075f5123d6c07d66
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
